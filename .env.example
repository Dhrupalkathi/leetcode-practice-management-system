# Copy to .env; never commit .env or share its values.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=leetcode
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password
DB_SSL=false
PORT=3000
NODE_ENV=development

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_64_character_hex_secret

# Judge0 execution provider (default hosted CE; execution is external)
# Use a self-hosted instance before running private company assessments.
JUDGE0_BASE_URL=https://ce.judge0.com
# Set only when your configured Judge0 instance requires a token.
# JUDGE0_AUTH_TOKEN=
JUDGE0_CPU_TIME_LIMIT=2
JUDGE0_CPU_EXTRA_TIME=1
JUDGE0_WALL_TIME_LIMIT=10
JUDGE0_MEMORY_LIMIT_KB=131072
JUDGE0_MAX_POLL_ATTEMPTS=60
JUDGE0_POLL_INTERVAL_MS=500

# Public app base URL used when generating candidate assessment invitation links.
APP_BASE_URL=http://127.0.0.1:3000
