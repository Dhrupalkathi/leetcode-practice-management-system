# Copy to .env; never commit .env or share its values.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=leetcode
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password
DB_SSL=false
PORT=3000
NODE_ENV=development

# Temporary local-only creator identity for CRUD before authentication is built.
# Set this to an EXISTING organizer_id. Do not use this as production authorization.
DEV_ORGANIZER_ID=82
